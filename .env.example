POSTGRES_DB=school_erp
POSTGRES_USER=school_erp
POSTGRES_PASSWORD=replace-this-db-password
DATABASE_URL=postgresql+psycopg://school_erp:replace-this-db-password@db:5432/school_erp
# Required: generate a unique value with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
ACCESS_TOKEN_MINUTES=60
# Required school code for global Developer (super_admin) sign-in
PLATFORM_SCHOOL_CODE=PLATFORM
# Required only when the database has no super_admin account. Never use example credentials.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=ERP Administrator
CORS_ORIGINS=http://localhost,http://localhost:5173

# Testing only: allow seeded demo accounts to skip email verification and login MFA
ENABLE_DEMO_LOGIN=false
# Show the demo-role picker on the login page (frontend build-time flag)
VITE_ENABLE_DEMO_MODE=false
